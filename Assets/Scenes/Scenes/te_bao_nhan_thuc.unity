    - target: {fileID: 6670094987955675628, guid: e1c0e5002953f4147bf8f0e96d212bf4, type: 3}
      propertyPath: m_text
      value: "\u2022<indent=4%><b>C\u1EA5u tr\xFAc</b>: B\u1ED9 m\xE1y Golgi \u0111\u01B0\u1EE3c
        c\u1EA5u t\u1EA1o b\u1EDFi l\u1EDBp m\xE0ng lipoprotein t\u1EA1o th\xE0nh
        h\u1EC7 th\u1ED1ng c\xE1c t\xFAi d\u1EB9p x\u1EBFp ch\u1ED3ng l\xEAn nhau
        v\xE0 li\xEAn k\u1EBFt v\u1EDBi nhau th\xF4ng qua c\xE1c protein n\u1EB1m
        tr\xEAn m\xE0ng c\u1EE7a ch\xFAng. B\u1ED9 m\xE1y Golgi c\xF3 c\u1EA5u tr\xFAc
        ph\xE2n c\u1EF1c g\u1ED3m m\u1EB7t nh\u1EADp (n\u01A1i ti\u1EBFp nh\u1EADn)
        v\xE0 m\u1EB7t xu\u1EA5t (n\u01A1i xu\u1EA5t \u0111i).</indent>\n\n\u2022<indent=4%><b>Ch\u1EE9c
        n\u0103ng</b>: ti\u1EBFp nh\u1EADn c\xE1c s\u1EA3n ph\u1EA9m t\u1EEB l\u01B0\u1EDBi
        n\u1ED9i ch\u1EA5t; bi\u1EBFn \u0111\u1ED5i, \u0111\xF3ng g\xF3i v\xE0 ph\xE2n
        ph\u1ED1i c\xE1c s\u1EA3n ph\u1EA9m n\xE0y \u0111\u1EBFn c\xE1c v\u1ECB tr\xED
        kh\xE1c nhau. Ngo\xE0i ra, b\u1ED9 m\xE1y Golgi c\xF2n tham gia v\xE0o qu\xE1
        tr\xECnh t\u1ED5ng h\u1EE3p m\u1ED9t s\u1ED1 polysaccharide v\xE0 ch\u1EA5t
        n\u1EC1n ngo\u1EA1i b\xE0o.</indent>"
      objectReference: {fileID: 0}
