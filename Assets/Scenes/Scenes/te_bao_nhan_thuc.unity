    - target: {fileID: 7308843183726104031, guid: e1c0e5002953f4147bf8f0e96d212bf4, type: 3}
      propertyPath: m_text
      value: "\u2022<indent=4%><b>M\xE0ng nh\xE2n</b>: M\xE0ng nh\xE2n g\u1ED3m m\xE0ng
        ngo\xE0i v\xE0 m\xE0ng trong, m\u1ED7i m\xE0ng d\xE0y 6 \u2013 9 nm. M\xE0ng
        ngo\xE0i th\u01B0\u1EDDng n\u1ED1i v\u1EDBi l\u01B0\u1EDBi n\u1ED9i ch\u1EA5t.
        Tr\xEAn b\u1EC1 m\u1EB7t m\xE0ng nh\xE2n c\xF3 r\u1EA5t nhi\u1EC1u l\u1ED7
        nh\xE2n c\xF3 \u0111\u01B0\u1EDDng k\xEDnh t\u1EEB 50 \u2013 80 nm. L\u1ED7
        nh\xE2n \u0111\u01B0\u1EE3c g\u1EAFn li\u1EC1n v\u1EDBi nhi\u1EC1u ph\xE2n
        t\u1EED protein cho ph\xE9p c\xE1c ph\xE2n t\u1EED nh\u1EA5t \u0111\u1ECBnh
        \u0111i v\xE0o hay \u0111i ra kh\u1ECFi nh\xE2n.</indent>\n\n\u2022<indent=4%><b>Ch\u1EA5t
        nhi\u1EC5m s\u1EAFc</b>: ch\u1EE9a DNA ho\u1EB7c v\u1EADt ch\u1EA5t di truy\u1EC1n
        li\xEAn k\u1EBFt v\u1EDBi nhi\u1EC1u protein ki\u1EC1m t\xEDnh. C\xE1c s\u1EE3i
        ch\u1EA5t nhi\u1EC5m s\u1EAFc qua qu\xE1 tr\xECnh co xo\u1EAFn t\u1EA1o th\xE0nh
        nhi\u1EC5m s\u1EAFc th\u1EC3 (NST) khi t\u1EBF b\xE0o th\u1EF1c hi\u1EC7n
        qu\xE1 tr\xECnh ph\xE2n b\xE0o.</indent>\n\n\u2022<indent=4%><b>Nh\xE2n con
        (hay c\xF2n g\u1ECDi l\xE0 h\u1EA1ch nh\xE2n)</b>: l\xE0 c\xE1c th\u1EC3
        h\xECnh c\u1EA7u b\u1EAFt m\xE0u \u0111\u1EADm h\u01A1n so v\u1EDBi ph\u1EA7n
        c\xF2n l\u1EA1i c\u1EE7a ch\u1EA5t nhi\u1EC5m s\u1EAFc, ch\u1EE9a ch\u1EE7
        y\u1EBFu l\xE0 protein v\xE0 rRNA.</indent>"
      objectReference: {fileID: 0}
