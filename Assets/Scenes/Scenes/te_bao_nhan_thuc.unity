  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Nh\xE2n t\u1EBF b\xE0o ph\u1EA7n l\u1EDBn c\xF3 h\xECnh b\u1EA7u d\u1EE5c
    hay h\xECnh c\u1EA7u v\u1EDBi \u0111\u01B0\u1EDDng k\xEDnh kho\u1EA3ng 5 \xB5m.
    \u0110a s\u1ED1 t\u1EBF b\xE0o ch\u1EC9 c\xF3 m\u1ED9t nh\xE2n, ch\xFAng c\xF3
    th\u1EC3 n\u1EB1m \u1EDF v\u1ECB tr\xED trung t\xE2m c\u1EE7a t\u1EBF b\xE0o
    ho\u1EB7c l\u1EC7ch t\xE2m. <br><br>B\xEAn trong nh\xE2n ch\u1EE9a kh\u1ED1i
    sinh ch\u1EA5t g\u1ECDi l\xE0 d\u1ECBch nh\xE2n, trong \u0111\xF3 c\xF3 m\u1ED9t
    v\xE0i nh\xE2n con v\xE0 c\xE1c s\u1EE3i ch\u1EA5t nhi\u1EC5m s\u1EAFc. <br><br>Nh\xE2n
    t\u1EBF b\xE0o c\xF3 vai tr\xF2 \u0111i\u1EC1u khi\u1EC3n m\u1ECDi ho\u1EA1t
    \u0111\u1ED9ng s\u1ED1ng c\u1EE7a t\u1EBF b\xE0o. <br><br>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f9fbdda271c78b648bcefb015ab2a28a, type: 2}
  m_sharedMaterial: {fileID: -8905258989600768385, guid: f9fbdda271c78b648bcefb015ab2a28a, type: 2}
