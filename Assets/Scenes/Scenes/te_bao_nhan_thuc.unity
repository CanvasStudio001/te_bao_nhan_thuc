      objectReference: {fileID: 0}
    - target: {fileID: 705584633234561183, guid: e1c0e5002953f4147bf8f0e96d212bf4, type: 3}
      propertyPath: m_text
      value: "\u2022<indent=4%><b>C\u1EA5u tr\xFAc</b>: Ribosome l\xE0 b\xE0o quan
        nh\u1ECF kh\xF4ng c\xF3 m\xE0ng bao b\u1ECDc. Ribosome c\xF3 k\xEDch th\u01B0\u1EDBc
        t\u1EEB 15 \u2013 25 nm. M\u1ED7i t\u1EBF b\xE0o c\xF3 t\u1EEB h\xE0ng tr\u0103m
        \u0111\u1EBFn h\xE0ng tri\u1EC7u ribosome. Ribosome \u0111\u01B0\u1EE3c c\u1EA5u
        t\u1EA1o ch\u1EE7 y\u1EBFu g\u1ED3m rRNA k\u1EBFt h\u1EE3p v\u1EDBi protein.
        M\u1ED7i ribosome g\u1ED3m m\u1ED9t ti\u1EC3u ph\u1EA7n l\u1EDBn v\xE0 m\u1ED9t
        ti\u1EC3u ph\u1EA7n nh\u1ECF.</indent>\n\n\u2022<indent=4%><b>Ch\u1EE9c n\u0103ng</b>:
        Ribosome l\xE0 n\u01A1i t\u1ED5ng h\u1EE3p protein cho t\u1EBF b\xE0o.</indent>"
      objectReference: {fileID: 0}
