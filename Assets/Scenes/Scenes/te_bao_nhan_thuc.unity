    - target: {fileID: 5995625993579993859, guid: e1c0e5002953f4147bf8f0e96d212bf4, type: 3}
      propertyPath: m_text
      value: "\u2022<indent=4%>Trung th\u1EC3 l\xE0 b\xE0o quan kh\xF4ng c\xF3 m\xE0ng,
        n\u1EB1m g\u1EA7n nh\xE2n trong t\u1EBF b\xE0o \u0111\u1ED9ng v\u1EADt. M\u1ED7i
        trung th\u1EC3 g\u1ED3m hai trung t\u1EED x\u1EBFp th\u1EB3ng g\xF3c v\u1EDBi
        nhau v\xE0 ch\u1EA5t quanh trung t\u1EED. Trung t\u1EED g\u1ED3m nhi\u1EC1u
        b\u1ED9 ba vi \u1ED1ng x\u1EBFp th\xE0nh v\xF2ng.</indent>\n\n\u2022<indent=4%>Trung
        th\u1EC3 c\xF3 vai tr\xF2 trong s\u1EF1 h\xECnh th\xE0nh thoi ph\xE2n b\xE0o,
        gi\xFAp nhi\u1EC5m s\u1EAFc th\u1EC3 di chuy\u1EC3n khi t\u1EBF b\xE0o ph\xE2n
        chia.</indent>"
