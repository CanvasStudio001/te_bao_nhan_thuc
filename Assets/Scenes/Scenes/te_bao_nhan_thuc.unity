    - target: {fileID: 1532613467493788138, guid: e1c0e5002953f4147bf8f0e96d212bf4, type: 3}
      propertyPath: m_text
      value: "\u2022<indent=4%><b>L\u01B0\u1EDBi n\u1ED9i ch\u1EA5t tr\u01A1n</b>
        kh\xF4ng c\xF3 ribosome \u0111\xEDnh tr\xEAn m\xE0ng, c\xF3 r\u1EA5t nhi\u1EC1u
        lo\u1EA1i enzyme, th\u1EF1c hi\u1EC7n ch\u1EE9c n\u0103ng t\u1ED5ng h\u1EE3p
        lipid, chuy\u1EC3n ho\xE1 \u0111\u01B0\u1EDDng, ph\xE2n hu\u1EF7 ch\u1EA5t
        \u0111\u1ED9c h\u1EA1i \u0111\u1ED1i v\u1EDBi t\u1EBF b\xE0o.\n "
      objectReference: {fileID: 0}
