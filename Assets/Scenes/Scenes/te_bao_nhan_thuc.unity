    - target: {fileID: 2476139628701719969, guid: e1c0e5002953f4147bf8f0e96d212bf4, type: 3}
      propertyPath: m_text
      value: "T\u1EBF b\xE0o nh\xE2n th\u1EF1c c\xF3 k\xEDch th\u01B0\u1EDBc kho\u1EA3ng
        10 \u2013 100 \xB5m, \u0111i\u1EC3n h\xECnh l\xE0 t\u1EBF b\xE0o th\u1EF1c
        v\u1EADt v\xE0 t\u1EBF b\xE0o \u0111\u1ED9ng v\u1EADt.. Ngo\xE0i vi\u1EC7c
        c\xF3 k\xEDch th\u01B0\u1EDBc l\u1EDBn h\u01A1n so v\u1EDBi t\u1EBF b\xE0o
        nh\xE2n s\u01A1 th\xEC c\u1EA5u t\u1EA1o c\u1EE7a t\u1EBF b\xE0o nh\xE2n
        th\u1EF1c c\u0169ng ph\u1EE9c t\u1EA1p h\u01A1n.\n\n\u2022<indent=4%>Ch\xFAng
        c\xF3 nh\xE2n ho\xE0n ch\u1EC9nh nh\u1EDD c\xF3 c\u1EA5u t\u1EA1o m\xE0ng
        nh\xE2n bao b\u1ECDc.</indent>\n\n\u2022<indent=4%>C\xF3 m\u1ED9t h\u1EC7
        th\u1ED1ng n\u1ED9i m\xE0ng r\u1ED9ng l\u1EDBn \u0111\u01B0\u1EE3c s\u1EAFp
        x\u1EBFp v\xF4 c\xF9ng g\u1ECDn g\xE0ng \u0111\u1EC3 chia t\u1EBF b\xE0o
        th\xE0nh nhi\u1EC1u ng\u0103n ri\xEAng bi\u1EC7t \u2013 ch\xEDnh l\xE0 nh\u1EEFng
        b\xE0o quan. M\u1ED7i ng\u0103n l\xE0 m\u1ED9t m\xF4i tr\u01B0\u1EDDng kh\xE1c
        nhau \u0111\u1EC3 c\xE1c ph\u1EA3n \u1EE9ng trao \u0111\u1ED5i ch\u1EA5t
        kh\xE1c nhau c\xF3 th\u1EC3 di\u1EC5n ra m\u1ED9t c\xE1ch thu\u1EADn l\u1EE3i.</indent>\n"
      objectReference: {fileID: 0}
