    - target: {fileID: 4997830890532195847, guid: e1c0e5002953f4147bf8f0e96d212bf4, type: 3}
      propertyPath: m_text
      value: "\u2022<indent=4%><b>C\u1EA5u tr\xFAc</b>: khung x\u01B0\u01A1ng t\u1EBF
        b\xE0o \u0111\u01B0\u1EE3c c\u1EA5u t\u1EA1o b\u1EDFi <b>vi \u1ED1ng, vi
        s\u1EE3i</b> v\xE0 <b>s\u1EE3i trung gian.</b></indent>\n\n\u2022<indent=4%><b>Ch\u1EE9c
        n\u0103ng</b>: n\xE2ng \u0111\u1EE1, duy tr\xEC h\xECnh d\u1EA1ng t\u1EBF
        b\xE0o, neo gi\u1EEF b\xE0o quan v\xE0 c\xE1c enzyme, h\xECnh th\xE0nh n\xEAn
        trung th\u1EC3 v\xE0 c\xF3 vai tr\xF2 trong qu\xE1 tr\xECnh ph\xE2n b\xE0o,
        h\u1ED7 tr\u1EE3 c\xE1c b\u1ED9 ph\u1EADn hay c\u1EA3 t\u1EBF b\xE0o di chuy\u1EC3n.</indent>\n"
      objectReference: {fileID: 0}
