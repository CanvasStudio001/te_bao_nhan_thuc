    - target: {fileID: 1372791620238830152, guid: e1c0e5002953f4147bf8f0e96d212bf4, type: 3}
      propertyPath: m_text
      value: "\u2022<indent=4%><b>C\u1EA5u tr\xFAc</b>: l\xE0 m\u1ED9t h\u1EC7 th\u1ED1ng
        m\xE0ng b\xEAn trong t\u1EBF b\xE0o (c\xF3 ngu\u1ED3n g\u1ED1c t\u1EEB m\xE0ng
        t\u1EBF b\xE0o ho\u1EB7c m\xE0ng nh\xE2n) t\u1EA1o th\xE0nh h\u1EC7 th\u1ED1ng
        c\xE1c k\xEAnh, t\xFAi v\xE0 \u1ED1ng th\xF4ng v\u1EDBi nhau. C\xF3 hai lo\u1EA1i
        l\xE0 <b>l\u01B0\u1EDBi n\u1ED9i ch\u1EA5t h\u1EA1t v\xE0 l\u01B0\u1EDBi
        n\u1ED9i ch\u1EA5t tr\u01A1n</b>.</indent>"
      objectReference: {fileID: 0}
