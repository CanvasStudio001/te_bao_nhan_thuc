      m_Calls: []
  m_text: "\u2022<indent=4%><b>C\u1EA5u tr\xFAc</b>: Ti th\u1EC3 l\xE0 b\xE0o quan
    \u0111\u01B0\u1EE3c bao b\u1ECDc b\u1EDFi hai l\u1EDBp m\xE0ng, b\xEAn trong
    ch\u1EA5t n\u1EC1n c\xF3 ch\u1EE9a DNA v\xE0 c\xE1c h\u1EA1t ribosome. M\xE0ng
    ngo\xE0i tr\u01A1n nh\u1EB5n, m\xE0ng trong g\u1EA5p n\u1EBFp t\u1EA1o th\xE0nh
    c\xE1c m\xE0o, tr\xEAn m\xE0o ch\u1EE9a h\u1EC7 th\u1ED1ng c\xE1c enzyme h\xF4
    h\u1EA5p.</indent>\n\n\u2022<indent=4%><b>Ch\u1EE9c n\u0103ng</b>: cung c\u1EA5p
    n\u0103ng l\u01B0\u1EE3ng d\u01B0\u1EDBi d\u1EA1ng d\u1EC5 s\u1EED d\u1EE5ng
    (ATP) cho m\u1ECDi ho\u1EA1t \u0111\u1ED9ng c\u1EE7a t\u1EBF b\xE0o.</indent>"
  m_isRightToLeft: 0
